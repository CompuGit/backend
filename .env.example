APP_NAME=Compugit_Python_REST_API
VERSION=3.0.1
ENV=development

HOST=0.0.0.0
PORT=5000
DEBUG=False
ENABLE_SWAGGER=True  # Development only; production must disable API docs.

# Leave empty only for development; set a unique 32+ character production secret.
SECRET_KEY=
ACCESS_TOKEN_EXPIRES=1  # 1 hour 
REFRESH_TOKEN_EXPIRES=1  # 1 day 

ENABLE_CORS=False
CORS_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=False
ALLOW_PUBLIC_REGISTRATION=False
MIN_PASSWORD_LENGTH=8
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
AUTO_CREATE_SCHEMA=True  # Creates missing relational tables at startup.
TRUST_PROXY=False  # Enable only behind a trusted reverse proxy/load balancer.
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=0
PROXY_FIX_X_HOST=0
API_MAX_CONTENT_LENGTH=2097152

# SQLite is the local-development default. Configure only the databases
# required by this application; every configured connection is initialized.
# Supported types: sqlite, mysql, postgresql, mongodb.
# DATABASES='{
# "sqlite_main": {
#     "type": "sqlite",
#     "path": "instance/app.sqlite3"
#   },
#   "sqlite_backup": {
#     "type": "sqlite",
#     "path": "instance/app_bkp.sqlite3"
#   },
#   "mysql_users": {
#     "type": "mysql",
#     "uri": "mysql+pymysql://user:password@localhost:3306/reports"
#   },
#   "mongo_documents": {
#     "type": "mongodb",
#     "uri": "mongodb://localhost:27017",
#     "database": "compugit",
#     "username": "root",
#     "password": "your_mongodb_password"
#   },
#   "postgres_analytics": {
#     "type": "postgresql",
#     "uri": "postgresql://user:password@localhost:5432/analytics"
#   }
# }'
PRIMARY_DATABASE=sqlite_main

# Production requires a strong SECRET_KEY and Redis for shared token revocation.
# ENABLE_CACHE=True
# CACHE_DB='{"type":"redis","uri":"redis://localhost:6379/0"}'
# CORS_ORIGINS=https://your-frontend.example