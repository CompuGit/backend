APP_NAME=Compugit_Python_REST_API
VERSION=2.1.0
ENV=dev

HOST=0.0.0.0
PORT=5000
DEBUG=False

SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRES=1  # 1 hour 
REFRESH_TOKEN_EXPIRES=1  # 1 day 

ENABLE_CORS=True
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000" # *

# Named database connections; use lowercase unique names.
# Supported types: sqlite, mysql, postgresql, mongodb.
DATABASES='{
  "sqlite_main": {
    "type": "sqlite",
    "path": "app/db.sqlite3"
  },
  "sqlite_backup": {
    "type": "sqlite",
    "path": "app/db_bkp.sqlite3"
  },
  "mysql_users": {
    "type": "mysql",
    "uri": "mysql+pymysql://user:password@localhost:3306/reports"
  },
  "mongo_reports": {
    "type": "mongodb",
    "uri": "mongodb://localhost:27017",
    "database": "compugit",
    "username": "root",
    "password": "your_mongodb_password"
  },
  "postgres_analytics": {
    "type": "postgresql",
    "uri": "postgresql://user:password@localhost:5432/analytics"
  }
}'
PRIMARY_DATABASE=sqlite_main
BACKUP_DATABASE=sqlite_backup  # Optional; set to the name of a backup database if needed.

# Cache database configuration
# ENABLE_CACHE=True
# CACHE_DB='{
#   "type": "redis",
#   "uri": "redis://localhost:6379/0"
# }'